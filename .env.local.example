# Neon PostgreSQL connection string (복붙하세요)
DATABASE_URL=postgresql://user:password@ep-xxx.ap-southeast-1.aws.neon.tech/alrami?sslmode=require

# npx web-push generate-vapid-keys 로 생성
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:your-email@example.com

# 한국 공휴일 조회용 공공데이터포털 Encoding 인증키 (선택, 없으면 fallback)
KOREA_DATA_GO_KR_API_KEY=

# Vercel Cron 보안용 랜덤 문자열
CRON_SECRET=
